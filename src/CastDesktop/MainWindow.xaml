<Window x:Class="CastDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CastDesktop - Transmission a Chromecast (Alta Calidad)"
        Height="720" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Configuration Panel -->
            <RowDefinition Height="*"/>
            <!-- Telemetry & Status Panel -->
            <RowDefinition Height="Auto"/>
            <!-- Logs Panel -->
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E88E5" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CastDesktop HD" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Transmisión de escritorio de Alta Calidad hacia Google Cast / Chromecast" FontSize="13" Foreground="#E3F2FD" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Background="#1565C0" CornerRadius="12" Padding="10,5">
                    <TextBlock x:Name="TxtBackendState" Text="Backend: Conectando..." Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Configuration Panel -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Options & Source Selection -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="1. Fuente de Captura" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbSourceType" SelectionChanged="CmbSourceType_SelectionChanged" Height="32" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Pantalla Completa (Escritorio)" IsSelected="True"/>
                                <ComboBoxItem Content="Ventana Específica"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="LblWindowTitle" Text="Título de Ventana:" FontSize="13" Foreground="#555" Margin="0,0,0,5" Visibility="Collapsed"/>
                        <TextBox x:Name="TxtWindowTitle" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15" Text="Calculator" Visibility="Collapsed"/>

                        <Separator Margin="0,5,0,15" Background="#E0E0E0"/>

                        <TextBlock Text="2. Dispositivo Chromecast" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbDevices" Grid.Column="0" Height="32" VerticalContentAlignment="Center" DisplayMemberPath="Name"/>
                            <Button x:Name="BtnRefreshDevices" Grid.Column="1" Content="🔄 Buscar" Width="80" Margin="10,0,0,0" Click="BtnRefreshDevices_Click" Height="32" Background="#ECEFF1" BorderBrush="#CFD8DC"/>
                        </Grid>

                        <Separator Margin="0,5,0,15" Background="#E0E0E0"/>

                        <TextBlock Text="3. Perfil de Calidad de Imagen" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <ComboBox x:Name="CmbQualityPreset" Height="32" VerticalContentAlignment="Center" SelectionChanged="CmbQualityPreset_SelectionChanged" Margin="0,0,0,15">
                            <ComboBoxItem Content="Alta (Prioridad Nitidez/Texto - 1080p/4K, 60 FPS, 35 Mbps)" IsSelected="True"/>
                            <ComboBoxItem Content="Media (Equilibrada - 1080p, 30 FPS, 18 Mbps)"/>
                            <ComboBoxItem Content="Baja (Red Limitada - 720p, 30 FPS, 6 Mbps)"/>
                            <ComboBoxItem Content="Personalizada"/>
                        </ComboBox>

                        <!-- Custom Controls -->
                        <Grid x:Name="GridCustomQuality" Margin="0,0,0,10" IsEnabled="False" Opacity="0.5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="FPS:" VerticalAlignment="Center"/>
                            <Slider x:Name="SldFps" Grid.Row="0" Grid.Column="1" Minimum="30" Maximum="60" Value="60" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="CustomSetting_Changed" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bitrate (Mbps):" VerticalAlignment="Center"/>
                            <Slider x:Name="SldBitrate" Grid.Row="1" Grid.Column="1" Minimum="15" Maximum="50" Value="35" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="CustomSetting_Changed" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Codec:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbCodec" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,5">
                                <ComboBoxItem Content="H.264 (libx264 - Profile High)" IsSelected="True"/>
                                <ComboBoxItem Content="H.265 (libx265 - HEVC 4K)"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Column 2: Controls & Warnings -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Control de Transmisión" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <Button x:Name="BtnStartStop" Content="▶ INICIAR TRANSMISIÓN" Height="55" FontSize="16" FontWeight="Bold" Foreground="White" Background="#4CAF50" BorderThickness="0" Click="BtnStartStop_Click" Margin="0,0,0,15"/>
                        <Button x:Name="BtnReconnect" Content="🔄 Reconectar Dispositivo" Height="36" FontSize="13" Foreground="#333" Background="#ECEFF1" BorderBrush="#CFD8DC" Click="BtnReconnect_Click" IsEnabled="False" Margin="0,0,0,15"/>

                        <Border x:Name="BorderWarning" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠️ Advertencia de Red" FontWeight="Bold" Foreground="#E65100"/>
                                <TextBlock x:Name="TxtWarningMessage" Text="El ancho de banda de red puede ser insuficiente para 35+ Mbps." TextWrapping="Wrap" Foreground="#EF6C00" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="💡 Nota de Calidad" FontWeight="SemiBold" Foreground="#495057" FontSize="12"/>
                            <TextBlock Text="Priorizando Nitidez e Imagen Nativa (1080p/4K). Latencia esperada: 1-3 segundos." TextWrapping="Wrap" Foreground="#6C757D" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Telemetry & Status Panel -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ESTADO" FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtStatusState" Text="Detenido" FontSize="14" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="FRAMERATE REAL" FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtStatusFps" Text="0.0 FPS" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="BITRATE ACTUAL" FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtStatusBitrate" Text="0 Kbps" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="LATENCIA ESTIMADA" FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtStatusLatency" Text="1 - 3 seg (Buffer HD)" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Logs Panel -->
        <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Registro de Diagnóstico y Mensajes" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,5"/>
                <ScrollViewer Grid.Row="1" x:Name="ScrollLogs" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLogs" Background="Transparent" Foreground="#4EC9B0" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
